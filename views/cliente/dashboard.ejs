<!DOCTYPE html>
<html lang="es">
<%- include('../partials/head') %> <!-- Incluir encabezado -->
<body>
  <div class="container mt-4">
    <h1>Catálogo de Juegos</h1>
    <h2>Bienvenido <%= user.username %></h2>
    <br>

    <div class="row">
      <% games.forEach(game => { %>
        <div class="col-md-4">
          <div class="card mb-4 shadow-sm">
            <div class="card-body">
              <h5 class="card-title"><%= game.titulo %></h5>
    
              <!-- Verificar si 'metadatos' existe antes de acceder a sus propiedades -->
              <p class="card-text">
                Desarrollador: <%= (game.metadatos && game.metadatos.desarrollador) ? game.metadatos.desarrollador : "N/A" %>
              </p>
              <p class="card-text">
                Lanzamiento: <%= (game.metadatos && game.metadatos.lanzamiento) ? game.metadatos.lanzamiento.toDateString() : "N/A" %>
              </p>
              <p class="card-text">
                Metacritic: <%= (game.metadatos && game.metadatos.metacritic) ?? "Sin calificación" %>
              </p>
    
              <p class="card-text">Plataformas: <%= game.plataformas ? game.plataformas.join(", ") : "N/A" %></p>
              
              <% if (game.stock.fisico > 0) { %>
                <a href="#" class="btn btn-primary">Comprar Físico</a>
              <% } %>
              
              <% if (game.stock.digital) { %>
                <a href="#" class="btn btn-outline-secondary">Comprar Digital</a>
              <% } %>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
    


 

  </div>
</body>
</html>